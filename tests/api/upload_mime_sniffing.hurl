# =============================================================
# OxiCloud – content-type sniffing on upload, end to end
#
# `common/mime_detect::refine_content_type` sniffs magic bytes BEFORE
# trusting the uploader's declared Content-Type, because the stored
# `mime_type` comes back as `Content-Type` on download and gates
# thumbnailing, metadata extraction and `getcontenttype` over WebDAV.
# It is a security decision, not a display hint.
#
# That ordering has one carve-out, and this scenario is its end-to-end
# pin. Some signatures describe the ENVELOPE rather than the content:
#
#   * a .docx / .xlsx / .odt / .epub IS a zip
#   * an .svg IS xml — and infer has no SVG matcher at all
#
# When the detection is one of those generics and the claim or the
# extension names a format that genuinely IS that envelope, the
# narrower answer wins. The narrowing is a whitelist, never an escape
# hatch: the bytes have already proved the envelope, so a claim can
# only say which flavour of it this is.
#
# Unit coverage for the rule lives in `src/common/mime_detect.rs`
# (`zip_envelope_defers_to_*`, `svg_is_an_image_not_xml`,
# `the_narrowing_cannot_smuggle_an_unrelated_type`). This file is the
# integration pin: the same decision, through the real multipart upload
# path, stored in storage.files and read back over the API.
#
# Fixtures are generated by run.sh §3.5 (python3 + zipfile) rather than
# committed — `sniff-padded.docx` in particular has to be built to a
# precise shape to be interesting. See the comments there.
#
# Prerequisites: setup.hurl must have run (admin user exists).
#
# Run:
#   hurl --variables-file tests/api/test.env --file-root tests \
#        --test tests/api/upload_mime_sniffing.hurl
# =============================================================


# ─────────────────────────────────────────────────────────────
# Step 1 – Login
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/auth/login
Content-Type: application/json
{
  "username": "{{username}}",
  "password": "{{password}}"
}

HTTP 200
[Captures]
token: jsonpath "$.access_token"


# ─────────────────────────────────────────────────────────────
# Step 2 – Working folder
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/folders
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "name": "hurl-mime-sniffing"
}

HTTP 201
[Captures]
folder_id: jsonpath "$.id"


# ─────────────────────────────────────────────────────────────
# Step 3 – A .docx whose `word/` entry sits beyond the sniff
# window, uploaded with the Content-Type a real browser sends.
#
# infer degrades to application/zip here. Before the carve-out the
# magic-first ordering let that overwrite a correct claim, so the
# document was stored as a bare archive — downloaded as
# application/zip, wrong icon, wrong handler.
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/files/upload
Authorization: Bearer {{token}}
[MultipartFormData]
folder_id: {{folder_id}}
file: file,fixtures/sniff-padded.docx; application/vnd.openxmlformats-officedocument.wordprocessingml.document

HTTP 201
[Captures]
docx_id: jsonpath "$.id"
[Asserts]
jsonpath "$.mime_type" == "application/vnd.openxmlformats-officedocument.wordprocessingml.document"


# It must survive the round trip — and this is the assertion that
# actually matters, because it checks the stored type on the WIRE.
#
# `mime_type` is not merely a label: `download_file` sets it as the
# response `Content-Type` (`file_handler.rs:1025`), which is what decides
# whether a browser renders or downloads the bytes. Asserting the header
# therefore tests the security-relevant property directly, rather than a
# JSON field that happens to agree with it.
#
# Two dead ends, recorded so nobody retries them:
#   * `GET /api/files/{id}` with a jsonpath assert — that endpoint
#     STREAMS THE CONTENT, so the assert runs against docx bytes and
#     fails with "could not decode response body with charset 'UTF-8'".
#   * `GET /api/files/{id}/metadata` — that is the EXIF/media metadata
#     (`storage.file_metadata`: captured_at, GPS, camera, dimensions).
#     It carries no `mime_type` at all, hence `actual: none`. There is no
#     single-file endpoint that returns it as JSON; the listing
#     (`GET /api/files?folder_id=…`) is the only JSON surface, as
#     files-folders.hurl uses.
#
# `contains` rather than `==`: the header may carry a `; charset=…`
# parameter, and the OOXML type is 71 characters. The exact string is
# asserted once above, where it documents the expectation.
GET {{base_url}}/api/files/{{docx_id}}
Authorization: Bearer {{token}}

HTTP 200
[Asserts]
header "Content-Type" contains "wordprocessingml.document"


# ─────────────────────────────────────────────────────────────
# Step 4 – The same archive with NO usable claim. The extension
# has to carry it on its own.
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/files/upload
Authorization: Bearer {{token}}
[MultipartFormData]
folder_id: {{folder_id}}
file: file,fixtures/sniff-padded.docx; application/octet-stream

HTTP 201
[Asserts]
jsonpath "$.mime_type" endsWith "wordprocessingml.document"


# ─────────────────────────────────────────────────────────────
# Step 5 – ⚠ The inverse. A plain archive must STAY an archive.
#
# The obvious bad fix for step 3 is "let the extension win for
# containers", which would also let it win here and in step 7. If
# this assertion ever flips, the narrowing stopped being a
# whitelist.
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/files/upload
Authorization: Bearer {{token}}
[MultipartFormData]
folder_id: {{folder_id}}
file: file,fixtures/sniff-plain.zip; application/zip

HTTP 201
[Asserts]
jsonpath "$.mime_type" == "application/zip"


# ─────────────────────────────────────────────────────────────
# Step 6 – EPUB. The spec mandates `mimetype` as the first, stored
# entry so sniffers can read it, and infer exploits that — this
# should need no help. Asserted anyway: if infer ever loses the
# matcher the carve-out catches it from the extension, and either
# way the stored type must be right.
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/files/upload
Authorization: Bearer {{token}}
[MultipartFormData]
folder_id: {{folder_id}}
file: file,fixtures/sniff-book.epub; application/epub+zip

HTTP 201
[Asserts]
jsonpath "$.mime_type" == "application/epub+zip"


# ─────────────────────────────────────────────────────────────
# Step 7 – SVG. An SVG starts with `<?xml`, so infer answers
# text/xml and there is no SVG matcher to do better.
#
# Stored as text/xml an SVG stops being an image everywhere at
# once: no thumbnail, absent from the photos grid, served with the
# wrong Content-Type. This is the costliest case of the three.
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/files/upload
Authorization: Bearer {{token}}
[MultipartFormData]
folder_id: {{folder_id}}
file: file,fixtures/sniff-logo.svg; image/svg+xml

HTTP 201
[Captures]
svg_id: jsonpath "$.id"
[Asserts]
jsonpath "$.mime_type" == "image/svg+xml"


# And with the client declining to guess.
POST {{base_url}}/api/files/upload
Authorization: Bearer {{token}}
[MultipartFormData]
folder_id: {{folder_id}}
file: file,fixtures/sniff-logo.svg; application/octet-stream

HTTP 201
[Asserts]
jsonpath "$.mime_type" == "image/svg+xml"


# On the wire too. This is the case where the served type matters most:
# stored as `text/xml` an SVG is not an image to anything downstream —
# no thumbnail, no tile in the photos grid, and a `Content-Type` that
# tells the browser it is a document rather than a picture.
GET {{base_url}}/api/files/{{svg_id}}
Authorization: Bearer {{token}}

HTTP 200
[Asserts]
header "Content-Type" contains "image/svg+xml"


# ─────────────────────────────────────────────────────────────
# Step 8 – ⚠ The security property, end to end.
#
# A client claims text/html for zip bytes. `text/html` does not
# specialise `application/zip`, so the narrowing must refuse it and
# the magic answer must stand. If this ever returns text/html, a
# crafted upload can choose how it is served back.
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/files/upload
Authorization: Bearer {{token}}
[MultipartFormData]
folder_id: {{folder_id}}
file: file,fixtures/sniff-plain.zip; text/html

HTTP 201
[Asserts]
jsonpath "$.mime_type" == "application/zip"


# Same shape, non-envelope detection: PNG bytes under a .docx name.
# A non-envelope detection gives the filename no say at all —
# otherwise the carve-out would hand the extension back the authority
# the magic-first change took away from the claim.
POST {{base_url}}/api/files/upload
Authorization: Bearer {{token}}
[MultipartFormData]
folder_id: {{folder_id}}
file: file,fixtures/green-image.png; application/vnd.openxmlformats-officedocument.wordprocessingml.document

HTTP 201
[Asserts]
jsonpath "$.mime_type" == "image/png"


# ─────────────────────────────────────────────────────────────
# Step 9 – Zero-byte files: the name is the ONLY signal.
#
# `touch plop` found this. With no content there is nothing for
# `infer` to match — not "no match found", but no bytes at all — so
# every empty upload falls through magic detection to the extension,
# permanently. The same place source code sits.
#
# The second case is the defect this pins. No extension AND a generic
# claim used to store `""`, which is not a Content-Type: it went into
# a column whose own DEFAULT is application/octet-stream, back out as
# the download `Content-Type`, and into every WebDAV
# `getcontenttype`. Two upload paths guarded the blank locally and the
# one every byte upload funnels through did not.
#
# Not `inode/x-empty` either, which is what `file --mime` reports:
# `inode` is not an IANA top-level type and means nothing to a client.
#
# `category` is asserted alongside because emptiness is NOT a category
# of its own — size is a separate axis, and the file browser already
# has an "Empty (0 B)" size bucket. An empty .txt is Text like any
# other .txt. Unit coverage: `mime_detect.rs::
# an_empty_file_is_typed_by_its_name_and_never_by_an_empty_string`.
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/files/upload
Authorization: Bearer {{token}}
[MultipartFormData]
folder_id: {{folder_id}}
file: file,fixtures/sniff-empty.txt; application/octet-stream

HTTP 201
[Asserts]
jsonpath "$.size" == 0
jsonpath "$.mime_type" == "text/plain"
jsonpath "$.category" == "Text"


# ⚠ Nothing to go on: no bytes, no extension, a generic claim.
POST {{base_url}}/api/files/upload
Authorization: Bearer {{token}}
[MultipartFormData]
folder_id: {{folder_id}}
file: file,fixtures/sniff-empty-noext; application/octet-stream

HTTP 201
[Asserts]
jsonpath "$.size" == 0
jsonpath "$.mime_type" == "application/octet-stream"
jsonpath "$.mime_type" != ""
jsonpath "$.mime_type" != "inode/x-empty"
jsonpath "$.category" == "Unknown"


# ─────────────────────────────────────────────────────────────
# Teardown – the suite shares one database; leave nothing behind.
# ─────────────────────────────────────────────────────────────
DELETE {{base_url}}/api/folders/{{folder_id}}
Authorization: Bearer {{token}}

HTTP *

# =============================================================
# OxiCloud — EXIF actually reaches the API, and one parse serves
# every copy of the content
# =============================================================
# Two gaps, one test.
#
# ── Gap 1: nothing uploaded a photo that HAS EXIF ────────────────────
# Every image fixture in the repo was EXIF-free, so no test had ever
# asserted a capture date, a camera or a GPS pair coming back out of
# the API. `photos_sort_date_content_clock.hurl` even depends on that
# absence (`captured_at not exists`) to prove its fallback arm.
#
# The consequence showed up the first time the metadata column was
# renamed: the Photos query went on selecting a column that no longer
# existed, and the only thing that noticed was a status-code assertion
# three files away. A 500 is a poor proxy for "EXIF works".
#
# `fixtures/exif-sample.jpg` closes it — 752 bytes, generated by
# `fixtures/make-exif-sample.py`, which documents every value it
# carries. Orientation 6 and a non-round GPS pair are deliberate: 0, 1
# and NULL are all values a bug produces by accident.
#
# ── Gap 2: the content-keying property was untested ──────────────────
# Capture facts moved from `storage.file_metadata` (keyed `file_id`) to
# `storage.content_metadata` (keyed `source_hash`). The whole point is
# that N copies of a photo share ONE extraction — which deleted the
# clone path that used to duplicate the row per copy.
#
# So the load-bearing assertion is the second one: upload the same
# bytes twice and both files report the same facts, with nothing having
# copied anything. Under the old keying the second file would come back
# empty unless a clone path ran; under the new keying it resolves
# through `blob_hash` to the row the first upload wrote. Delete the
# content join and this fails, while every single-file test still
# passes.
#
# `GET /api/files/{id}/metadata` is the probe rather than
# `/api/photos/resources` because the media listing is
# `DISTINCT ON (blob_hash)` — two copies of one blob collapse to a
# single item there, which is exactly the thing being tested, made
# invisible.
#
# Extraction is asynchronous (a lifecycle hook on a blocking pool), so
# the first read retries. The second does not need to: by then the row
# exists, and if the copy had to extract for itself, that would BE the
# regression.
#
# Self-contained: own folders, removed in teardown.
# =============================================================


# ─────────────────────────────────────────────────────────────
# Setup
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/auth/login
Content-Type: application/json
{ "username": "{{username}}", "password": "{{password}}" }

HTTP 200
[Captures]
jwt: jsonpath "$.access_token"


POST {{base_url}}/api/folders
Authorization: Bearer {{jwt}}
Content-Type: application/json
{ "name": "hurl-exif-a" }

HTTP 201
[Captures]
folder_a: jsonpath "$.id"


POST {{base_url}}/api/folders
Authorization: Bearer {{jwt}}
Content-Type: application/json
{ "name": "hurl-exif-b" }

HTTP 201
[Captures]
folder_b: jsonpath "$.id"


# ─────────────────────────────────────────────────────────────
# Upload the EXIF-bearing photo.
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/files/upload
Authorization: Bearer {{jwt}}
[MultipartFormData]
folder_id: {{folder_a}}
file: file,fixtures/exif-sample.jpg; image/jpeg

HTTP 201
[Captures]
file_a: jsonpath "$.id"


# ─────────────────────────────────────────────────────────────
# THE values. Retries because extraction is asynchronous — the
# upload returns before the hook has parsed anything.
#
# Every field is pinned, not just the date: the date alone would
# survive a merge bug that dropped GPS, and GPS is the field a
# sign error silently relocates to another continent.
# ─────────────────────────────────────────────────────────────
GET {{base_url}}/api/files/{{file_a}}/metadata
Authorization: Bearer {{jwt}}
[Options]
retry: 20
retry-interval: 250

HTTP 200
[Asserts]
jsonpath "$.captured_at"   == "2019-07-14T10:30:00Z"
jsonpath "$.camera_make"   == "OxiCloud"
jsonpath "$.camera_model"  == "TestCam A1"
# 6 = rotate 90° CW. Not 1, which is what "no orientation read" looks
# like once a default creeps in.
jsonpath "$.orientation"   == 6
# 48° 2' 18" N, 4° 44' 3" W — Pointe du Raz. The longitude is NEGATIVE:
# a dropped GPSLongitudeRef puts this photo in Asia and still returns
# 200, so the sign is the assertion that matters.
jsonpath "$.latitude"      > 48.0
jsonpath "$.latitude"      < 48.1
jsonpath "$.longitude"     < -4.7
jsonpath "$.longitude"     > -4.8


# ─────────────────────────────────────────────────────────────
# The same bytes again, in another folder. Same content hash,
# so this is a second FILE on content already extracted.
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/files/upload
Authorization: Bearer {{jwt}}
[MultipartFormData]
folder_id: {{folder_b}}
file: file,fixtures/exif-sample.jpg; image/jpeg

HTTP 201
[Captures]
file_b: jsonpath "$.id"


# ─────────────────────────────────────────────────────────────
# THE content-keying assertion.
#
# No retry on purpose. The row was written by the first upload and
# is reachable through this file's `blob_hash` immediately — that
# is what content-keying means. If this needed to wait, something
# extracted a second time and the dedup guarantee is gone.
# ─────────────────────────────────────────────────────────────
GET {{base_url}}/api/files/{{file_b}}/metadata
Authorization: Bearer {{jwt}}

HTTP 200
[Asserts]
jsonpath "$.captured_at"  == "2019-07-14T10:30:00Z"
jsonpath "$.camera_make"  == "OxiCloud"
jsonpath "$.camera_model" == "TestCam A1"
jsonpath "$.orientation"  == 6
jsonpath "$.latitude"     > 48.0
jsonpath "$.longitude"    < -4.7


# ─────────────────────────────────────────────────────────────
# Deleting one copy must not strip the other.
#
# Content-keyed rows hold no ref_count and no FK, so they outlive
# the file on purpose — they die with the BLOB, not with one of its
# references. A cascade reintroduced on `file_id` would pass every
# assertion above and fail here.
# ─────────────────────────────────────────────────────────────
DELETE {{base_url}}/api/files/{{file_a}}
Authorization: Bearer {{jwt}}

HTTP 204


GET {{base_url}}/api/files/{{file_b}}/metadata
Authorization: Bearer {{jwt}}

HTTP 200
[Asserts]
jsonpath "$.captured_at" == "2019-07-14T10:30:00Z"
jsonpath "$.longitude"   < -4.7


# ═════════════════════════════════════════════════════════════
# Teardown
# ═════════════════════════════════════════════════════════════
DELETE {{base_url}}/api/files/{{file_b}}
Authorization: Bearer {{jwt}}

HTTP 204


DELETE {{base_url}}/api/folders/{{folder_b}}
Authorization: Bearer {{jwt}}

HTTP 204


DELETE {{base_url}}/api/folders/{{folder_a}}
Authorization: Bearer {{jwt}}

HTTP 204

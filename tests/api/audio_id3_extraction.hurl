# =============================================================
# OxiCloud — ID3 tags actually reach the API, and one parse serves
# every copy of the content
# =============================================================
# The audio twin of `photos_exif_extraction.hurl`, and the gap here was
# wider: `audio.file_metadata` was re-keyed to `audio.content_metadata`
# with no test anywhere — not at the API, not in the service — asserting
# that a title or an artist survives the trip out of a blob.
#
# The failure mode is quiet in both directions. A parser returning
# nothing looks exactly like a song with no tags, and `extract_and_save`
# then skips the upsert; meanwhile extraction is GATED on
# `is_audio_file(mime_type)`, so a mistyped upload means tags never get
# parsed at all. Content-first MIME sniffing moved that gate underneath
# this feature, which is reason enough to pin the whole path.
#
# This test caught a live bug on its first run: `id3::Tag::year()` reads
# only TYER, the ID3v2.3 field, while every modern encoder writes the
# v2.4 TDRC — so `year` had been silently NULL for most real uploads.
# `year` is asserted below for that reason; it is not padding.
#
# ── The content-keying assertion ─────────────────────────────────────
# Tags are a pure function of the bytes, so N copies of a song share ONE
# extraction — the property that let the per-copy clone path be deleted.
# Upload the same bytes twice: the second file must report the same tags
# without anything having copied a row. Under the old file-keying it
# would come back empty unless the clone path ran.
#
# `fixtures/id3-sample.mp3` is 2.2 KB, regenerated byte-for-byte by
# `scripts/helpers/make-id3-fixture.sh`.
#
# Self-contained: own folders, removed in teardown.
# =============================================================


# ─────────────────────────────────────────────────────────────
# Setup
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/auth/login
Content-Type: application/json
{ "username": "{{username}}", "password": "{{password}}" }

HTTP 200
[Captures]
jwt: jsonpath "$.access_token"


POST {{base_url}}/api/folders
Authorization: Bearer {{jwt}}
Content-Type: application/json
{ "name": "hurl-id3-a" }

HTTP 201
[Captures]
folder_a: jsonpath "$.id"


POST {{base_url}}/api/folders
Authorization: Bearer {{jwt}}
Content-Type: application/json
{ "name": "hurl-id3-b" }

HTTP 201
[Captures]
folder_b: jsonpath "$.id"


# ─────────────────────────────────────────────────────────────
# Upload the tagged MP3.
#
# No Content-Type is claimed for the part beyond audio/mpeg; the
# stored type comes from the magic bytes either way, and the
# extraction gate reads the STORED type.
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/files/upload
Authorization: Bearer {{jwt}}
[MultipartFormData]
folder_id: {{folder_a}}
file: file,fixtures/id3-sample.mp3; audio/mpeg

HTTP 201
[Captures]
file_a: jsonpath "$.id"


# ─────────────────────────────────────────────────────────────
# THE tags. Retries because extraction is asynchronous.
# ─────────────────────────────────────────────────────────────
GET {{base_url}}/api/playlists/audio-metadata/{{file_a}}
Authorization: Bearer {{jwt}}
[Options]
retry: 20
retry-interval: 250

HTTP 200
[Asserts]
jsonpath "$.title"        == "Sniff Test"
jsonpath "$.artist"       == "OxiCloud QA"
jsonpath "$.album"        == "Fixture Sessions"
# TPE2, read by walking frames by hand rather than a typed accessor —
# its own failure mode, and silent.
jsonpath "$.album_artist" == "Various QA"
jsonpath "$.genre"        == "Electronic"
jsonpath "$.track_number" == 7
jsonpath "$.disc_number"  == 2
# TDRC, not TYER. This assertion is the bug this file found.
jsonpath "$.year"         == 2019


# ─────────────────────────────────────────────────────────────
# The same bytes again. Same content hash, so this is a second
# FILE on content already extracted.
# ─────────────────────────────────────────────────────────────
POST {{base_url}}/api/files/upload
Authorization: Bearer {{jwt}}
[MultipartFormData]
folder_id: {{folder_b}}
file: file,fixtures/id3-sample.mp3; audio/mpeg

HTTP 201
[Captures]
file_b: jsonpath "$.id"


# ─────────────────────────────────────────────────────────────
# THE content-keying assertion.
#
# No retry on purpose: the row exists already and is reachable
# through this file's `blob_hash`. Needing to wait would mean a
# second extraction ran, i.e. the dedup guarantee is gone.
# ─────────────────────────────────────────────────────────────
GET {{base_url}}/api/playlists/audio-metadata/{{file_b}}
Authorization: Bearer {{jwt}}

HTTP 200
[Asserts]
jsonpath "$.title"        == "Sniff Test"
jsonpath "$.artist"       == "OxiCloud QA"
jsonpath "$.album_artist" == "Various QA"
jsonpath "$.year"         == 2019


# ─────────────────────────────────────────────────────────────
# Deleting one copy must not strip the other — the row is keyed to
# the content and dies with the BLOB, not with one of its
# references. A cascade reintroduced on `file_id` passes everything
# above and fails here.
# ─────────────────────────────────────────────────────────────
DELETE {{base_url}}/api/files/{{file_a}}
Authorization: Bearer {{jwt}}

HTTP 204


GET {{base_url}}/api/playlists/audio-metadata/{{file_b}}
Authorization: Bearer {{jwt}}

HTTP 200
[Asserts]
jsonpath "$.title" == "Sniff Test"
jsonpath "$.year"  == 2019


# ═════════════════════════════════════════════════════════════
# Teardown
# ═════════════════════════════════════════════════════════════
DELETE {{base_url}}/api/files/{{file_b}}
Authorization: Bearer {{jwt}}

HTTP 204


DELETE {{base_url}}/api/folders/{{folder_b}}
Authorization: Bearer {{jwt}}

HTTP 204


DELETE {{base_url}}/api/folders/{{folder_a}}
Authorization: Bearer {{jwt}}

HTTP 204

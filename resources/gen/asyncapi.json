      "RtEventDataUnion": {
        "description": "Tagged union of every possible `rt.event` payload. Discriminated by the sibling `event` field (see `RtEventKind`).",
        "oneOf": [
          {
            "$ref": "#/components/schemas/FileCreatedData"

{
  "asyncapi": "3.0.0",
  "channels": {
    "Collab": {
      "address": "collab:{fileId}",
      "description": "Collaborative `.md` editing over Yjs. Two frame families ride the same channel:\n\n  * **JSON-RPC control plane** (`rt.subscribe` / `rt.unsubscribe` / `rt.collab_flush`) — same text-frame shape as every other channel.\n  * **Binary data plane** — Yjs sync protocol as raw bytes: `[1 byte kind][16 bytes file_id BE][payload]`. Kinds: `0x01` UPDATE (Yjs update blob), `0x02` AWARENESS (presence, not persisted), `0x03` SYNC (state vector c→s / diff s→c).\n\nAuthZ: `Read` on the file for subscribe (JSON) and for `0x03 SYNC` (defense-in-depth vs the subscribe gate). `Update` on the file for `0x01 UPDATE` and `rt.collab_flush`. AWARENESS is presence-only and rides the subscribe-time Read gate.\n\nSee `docs/plan/markdown-collab.md` and `src/application/services/collab_wire.rs`.",
      "messages": {
        "CollabAwarenessFrame": {
          "$ref": "#/components/messages/CollabAwarenessFrame"
        },
        "CollabFlushRequest": {
          "$ref": "#/components/messages/RtCollabFlushRequest"
        },
        "CollabFlushResponse": {
          "$ref": "#/components/messages/RtCollabFlushResponse"
        },
        "CollabSyncFrame": {
          "$ref": "#/components/messages/CollabSyncFrame"
        },
        "CollabUpdateFrame": {
          "$ref": "#/components/messages/CollabUpdateFrame"
        },
        "ErrorResponse": {
          "$ref": "#/components/messages/RtErrorResponse"
        },
        "RevokedNotification": {
          "$ref": "#/components/messages/RtRevokedNotification"
        },
        "SubscribeRequest": {
          "$ref": "#/components/messages/RtSubscribeRequest"
        },
        "SubscribedResponse": {
          "$ref": "#/components/messages/RtSubscribedResponse"
        },
        "UnsubscribeRequest": {
          "$ref": "#/components/messages/RtUnsubscribeRequest"
        }
      },
      "parameters": {
        "fileId": {
          "description": "File UUID — the target `.md` file"
        }
      }
    },
    "Folder": {
      "address": "folder:{folderId}",
      "description": "A folder's mutation stream — file/subfolder created events fire here. AuthZ: caller must hold `Read` on the folder.",
      "messages": {
        "ErrorResponse": {
          "$ref": "#/components/messages/RtErrorResponse"
        },
        "FolderEvent": {
          "$ref": "#/components/messages/RtFolderEventNotification"
        },
        "PingRequest": {
          "$ref": "#/components/messages/RtPingRequest"
        },
        "PongResponse": {
          "$ref": "#/components/messages/RtPongResponse"
        },
        "RevokedNotification": {
          "$ref": "#/components/messages/RtRevokedNotification"
        },
        "SubscribeRequest": {
          "$ref": "#/components/messages/RtSubscribeRequest"
        },
        "SubscribedResponse": {
          "$ref": "#/components/messages/RtSubscribedResponse"
        },
        "UnsubscribeRequest": {
          "$ref": "#/components/messages/RtUnsubscribeRequest"
        }
      },
      "parameters": {
        "folderId": {
          "description": "Folder UUID"
        }
      }
    },
    "Job": {
      "address": "job:{jobName}",
      "description": "A named background job's run lifecycle — Started / Progress / Ended. Consumed by the admin dashboard so operators who trigger a long-running job (backend migration, thumb import…) can navigate off the admin page and come back without losing progress. AuthZ: admin-only (Class 3 role-scoped) — non-admin gets `topic_forbidden`, indistinguishable on the wire from an unknown topic.",
      "messages": {
        "ErrorResponse": {
          "$ref": "#/components/messages/RtErrorResponse"
        },
        "JobEvent": {
          "$ref": "#/components/messages/RtFolderEventNotification"
        },
        "RevokedNotification": {
          "$ref": "#/components/messages/RtRevokedNotification"
        },
        "SubscribeRequest": {
          "$ref": "#/components/messages/RtSubscribeRequest"
        },
        "SubscribedResponse": {
          "$ref": "#/components/messages/RtSubscribedResponse"
        },
        "UnsubscribeRequest": {
          "$ref": "#/components/messages/RtUnsubscribeRequest"
        }
      },
      "parameters": {
        "jobName": {
          "description": "Scheduler-registered short slug (e.g. `backend_migration`); `[a-z0-9_-]` chars only"
        }
      }
    },
    "UserAuthz": {
      "address": "user:{userId}:authz",
      "description": "A user's private AuthZ-change channel. Identity-scoped: caller_id must equal userId (no admin bypass).",
      "messages": {
        "SubscribeRequest": {
          "$ref": "#/components/messages/RtSubscribeRequest"
        },
        "UnsubscribeRequest": {
          "$ref": "#/components/messages/RtUnsubscribeRequest"
        }
      },
      "parameters": {
        "userId": {
          "description": "User UUID — must match the authenticated caller"
        }
      }
    },
    "UserNotifications": {
      "address": "user:{userId}:notifications",
      "description": "A user's private notifications channel. Identity-scoped: caller_id must equal userId (no admin bypass). Auto-subscribed at session open; the FE bell refetches `GET /api/notifications` when a `notification_received` event fires. The DB row is authoritative — a missed push recovers on the next mount.",
      "messages": {
        "SubscribeRequest": {
          "$ref": "#/components/messages/RtSubscribeRequest"
        },
        "UnsubscribeRequest": {
          "$ref": "#/components/messages/RtUnsubscribeRequest"
        }
      },
      "parameters": {
        "userId": {
          "description": "User UUID — must match the authenticated caller"
        }
      }
    }
  },
  "components": {
    "messages": {
      "CollabAwarenessFrame": {
        "contentType": "application/octet-stream",
        "name": "collab.awareness",
        "payload": {
          "$ref": "#/components/schemas/CollabBinaryFrame"
        },
        "title": "0x02 AWARENESS — presence (bidirectional, not persisted)"
      },
      "CollabSyncFrame": {
        "contentType": "application/octet-stream",
        "name": "collab.sync",
        "payload": {
          "$ref": "#/components/schemas/CollabBinaryFrame"
        },
        "title": "0x03 SYNC — Yjs state vector (c→s) / update diff (s→c)"
      },
      "CollabUpdateFrame": {
        "contentType": "application/octet-stream",
        "name": "collab.update",
        "payload": {
          "$ref": "#/components/schemas/CollabBinaryFrame"
        },
        "title": "0x01 UPDATE — Yjs update blob (bidirectional)"
      },
      "RtCollabFlushRequest": {
        "contentType": "application/json",
        "examples": [
          {
            "name": "collab-flush",
            "payload": {
              "id": 7,
              "jsonrpc": "2.0",
              "method": "rt.collab_flush",
              "params": {
                "file_id": "00000000-0000-0000-0000-000000000000"
              }
            },
            "summary": "Client → server: on tab close / explicit save"
          }
        ],
        "name": "rt.collab_flush",
        "payload": {
          "$ref": "#/components/schemas/RtCollabFlushRequestBody"
        },
        "title": "Force flush of the CRDT text to the file's blob"
      },
      "RtCollabFlushResponse": {
        "contentType": "application/json",
        "examples": [
          {
            "name": "collab-flush-ok-wrote",
            "payload": {
              "id": 7,
              "jsonrpc": "2.0",
              "result": {
                "flushed": true
              }
            },
            "summary": "Server → client: a blob write happened"
          },
          {
            "name": "collab-flush-ok-noop",
            "payload": {
              "id": 7,
              "jsonrpc": "2.0",
              "result": {
                "flushed": false
              }
            },
            "summary": "Server → client: unchanged content, short-circuited"
          }
        ],
        "name": "rt.collab_flush.reply",
        "payload": {
          "$ref": "#/components/schemas/RtCollabFlushResponseBody"
        },
        "title": "Collab flush ack — `result.flushed`"
      },
      "RtErrorResponse": {
        "contentType": "application/json",
        "examples": [
          {
            "name": "error-no-read",
            "payload": {
              "error": {
                "code": -32001,
                "data": {
                  "topic": "folder:00000000-0000-0000-0000-000000000000"
                },
                "message": "no_read"
              },
              "id": 1,
              "jsonrpc": "2.0"
            },
            "summary": "Server → client: rt.subscribe refused because caller lacks Read on the folder"
          }
        ],
        "name": "rt.error",
        "payload": {
          "$ref": "#/components/schemas/RtErrorResponseBody"
        },
        "title": "JSON-RPC error object"
      },
      "RtFolderEventNotification": {
        "contentType": "application/json",
        "examples": [
          {
            "name": "event-file-created",
            "payload": {
              "jsonrpc": "2.0",
              "method": "rt.event",
              "params": {
                "data": {
                  "content_hash": "b3-…",
                  "created_at": "2026-09-13T18:04:00Z",
                  "id": "11111111-1111-1111-1111-111111111111",
                  "name": "report.pdf",
                  "size": 12345
                },
                "kind": "file.created",
                "seq": 17,
                "topic": "folder:00000000-0000-0000-0000-000000000000"
              }
            },
            "summary": "Server → client: a file was created inside a subscribed folder"
          }
        ],
        "name": "rt.event",
        "payload": {
          "$ref": "#/components/schemas/RtFolderEventBody"
        },
        "title": "Folder mutation event"
      },
      "RtPingRequest": {
        "contentType": "application/json",
        "examples": [
          {
            "name": "ping",
            "payload": {
              "id": 42,
              "jsonrpc": "2.0",
              "method": "rt.ping"
            },
            "summary": "Client → server: liveness probe (reply is rt.pong)"
          }
        ],
        "name": "rt.ping",
        "payload": {
          "$ref": "#/components/schemas/RtPingRequestBody"
        },
        "title": "Keepalive ping"
      },
      "RtPongResponse": {
        "contentType": "application/json",
        "examples": [
          {
            "name": "pong",
            "payload": {
              "id": 42,
              "jsonrpc": "2.0",
              "result": {
                "pong": true
              }
            },
            "summary": "Server → client: reply to a client rt.ping"
          }
        ],
        "name": "rt.pong",
        "payload": {
          "$ref": "#/components/schemas/RtPongResponseBody"
        },
        "title": "Reply to rt.ping — `result.pong == true`"
      },
      "RtRevokedNotification": {
        "contentType": "application/json",
        "examples": [
          {
            "name": "revoked-permission-lost",
            "payload": {
              "jsonrpc": "2.0",
              "method": "rt.revoked",
              "params": {
                "reason": "permission_lost",
                "topic": "folder:00000000-0000-0000-0000-000000000000"
              }
            },
            "summary": "Server → client: subscription evicted because the caller lost Read on the folder"
          }
        ],
        "name": "rt.revoked",
        "payload": {
          "$ref": "#/components/schemas/RtRevokedBody"
        },
        "title": "Subscription evicted"
      },
      "RtSubscribeRequest": {
        "contentType": "application/json",
        "examples": [
          {
            "name": "subscribe-folder",
            "payload": {
              "id": 1,
              "jsonrpc": "2.0",
              "method": "rt.subscribe",
              "params": {
                "topic": "folder:00000000-0000-0000-0000-000000000000"
              }
            },
            "summary": "Client → server: subscribe to a folder's mutation stream"
          }
        ],
        "name": "rt.subscribe",
        "payload": {
          "$ref": "#/components/schemas/RtSubscribeRequestBody"
        },
        "title": "Subscribe to a topic"
      },
      "RtSubscribedResponse": {
        "contentType": "application/json",
        "examples": [
          {
            "name": "subscribed-ok",
            "payload": {
              "id": 1,
              "jsonrpc": "2.0",
              "result": {
                "ok": true
              }
            },
            "summary": "Server → client: successful rt.subscribe / rt.unsubscribe ack"
          }
        ],
        "name": "rt.subscribed",
        "payload": {
          "$ref": "#/components/schemas/RtSuccessResponseBody"
        },
        "title": "Subscribe / unsubscribe ack"
      },
      "RtUnsubscribeRequest": {
        "contentType": "application/json",
        "examples": [
          {
            "name": "unsubscribe-folder",
            "payload": {
              "id": 2,
              "jsonrpc": "2.0",
              "method": "rt.unsubscribe",
              "params": {
                "topic": "folder:00000000-0000-0000-0000-000000000000"
              }
            },
            "summary": "Client → server: unsubscribe from a previously-joined folder"
          }
        ],
        "name": "rt.unsubscribe",
        "payload": {
          "$ref": "#/components/schemas/RtUnsubscribeRequestBody"
        },
        "title": "Unsubscribe from a topic"
      }
    },
    "schemas": {
      "CollabBinaryFrame": {
        "description": "Raw bytes of a collab wire frame. Layout: `[1 byte kind][16 bytes file_id BE][payload...]`. `kind`: `0x01` UPDATE (Yjs update blob), `0x02` AWARENESS (opaque presence bytes, not persisted), `0x03` SYNC (Yjs state vector c→s / Yjs update s→c). `file_id` is a UUID serialised as its 16 raw bytes (matches `Uuid::as_bytes()` on the server; `y-codemirror.next` binary handling on the client). Empty payloads are legal only for the SYNC direction that carries a state vector of zero clients — Yjs encodes that as a single `0x00` byte, NOT zero bytes.",
        "format": "binary",
        "type": "string"
      },
      "FileCreatedData": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "format": "uuid",
            "type": "string"
          },
          "file_id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parent_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "file_id",
          "name",
          "parent_id",
          "actor"
        ],
        "type": "object"
      },
      "FileDeletedData": {
        "additionalProperties": false,
        "description": "The wire doesn't distinguish soft (trash) vs. permanent delete — clients treat both as \"disappears from the folder view\". `parent_id` is the folder the file used to live in.",
        "properties": {
          "actor": {
            "format": "uuid",
            "type": "string"
          },
          "file_id": {
            "format": "uuid",
            "type": "string"
          },
          "parent_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "file_id",
          "parent_id",
          "actor"
        ],
        "type": "object"
      },
      "FileMovedData": {
        "additionalProperties": false,
        "description": "Emitted on BOTH the source (`from`) and destination (`to`) folder topics. Subscribers to either see the event exactly once because they're subscribed to only one of the two.",
        "properties": {
          "actor": {
            "format": "uuid",
            "type": "string"
          },
          "file_id": {
            "format": "uuid",
            "type": "string"
          },
          "from": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "to": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "file_id",
          "name",
          "from",
          "to",
          "actor"
        ],
        "type": "object"
      },
      "FileRenamedData": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "format": "uuid",
            "type": "string"
          },
          "file_id": {
            "format": "uuid",
            "type": "string"
          },
          "new_name": {
            "type": "string"
          },
          "old_name": {
            "type": "string"
          },
          "parent_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "file_id",
          "old_name",
          "new_name",
          "parent_id",
          "actor"
        ],
        "type": "object"
      },
      "FolderCreatedData": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "format": "uuid",
            "type": "string"
          },
          "folder_id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parent_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "folder_id",
          "name",
          "parent_id",
          "actor"
        ],
        "type": "object"
      },
      "FolderDeletedData": {
        "additionalProperties": false,
        "description": "Soft vs. permanent delete are indistinguishable on the wire.",
        "properties": {
          "actor": {
            "format": "uuid",
            "type": "string"
          },
          "folder_id": {
            "format": "uuid",
            "type": "string"
          },
          "parent_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "folder_id",
          "parent_id",
          "actor"
        ],
        "type": "object"
      },
      "FolderMovedData": {
        "additionalProperties": false,
        "description": "Emitted on BOTH the source (`from`) and destination (`to`) folder topics — same shape as `FileMoved`.",
        "properties": {
          "actor": {
            "format": "uuid",
            "type": "string"
          },
          "folder_id": {
            "format": "uuid",
            "type": "string"
          },
          "from": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "to": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "folder_id",
          "name",
          "from",
          "to",
          "actor"
        ],
        "type": "object"
      },
      "FolderRenamedData": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "format": "uuid",
            "type": "string"
          },
          "folder_id": {
            "format": "uuid",
            "type": "string"
          },
          "new_name": {
            "type": "string"
          },
          "old_name": {
            "type": "string"
          },
          "parent_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "folder_id",
          "old_name",
          "new_name",
          "parent_id",
          "actor"
        ],
        "type": "object"
      },
      "JobRunEndedData": {
        "additionalProperties": false,
        "description": "A background job's run ended. `success = true` for a normal completion; `false` for failure / timeout / cancelled / paused-with-unhandled-outcome. `reason` populates the toast text on the `false` branch and links to `/admin/jobs/<name>` for the full outcome. Consumer typically drops its subscription on receipt (job is done).",
        "properties": {
          "ended_at": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "success",
          "ended_at"
        ],
        "type": "object"
      },
      "JobRunProgressData": {
        "additionalProperties": false,
        "description": "A background job made progress. Throttled at the publish site to at most one per 3 s per job (see scheduler engine). `step` / `total` populate a progress bar; all three fields are optional because different jobs report different granularities.",
        "properties": {
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "step": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "total": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "JobRunStartedData": {
        "additionalProperties": false,
        "description": "A background job's run started. `name` matches the scheduler-registered job name (e.g. `backend_migration`). `actor` is `00000000-0000-0000-0000-000000000000` today — the scheduler doesn't yet thread the trigger caller through.",
        "properties": {
          "actor": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "name",
          "started_at",
          "actor"
        ],
        "type": "object"
      },
      "NotificationReceivedData": {
        "additionalProperties": false,
        "description": "A new notification was created for the caller. Pure cache-invalidation event — no fields on the wire. The FE refetches `GET /api/notifications` on receipt and reads the payload from the REST DTO (see `openapi.json`). Zero schema overlap between the bus wire (this file) and the REST wire — the strict form of the AsyncAPI-defines-envelope / OpenAPI-defines-payload split.",
        "properties": {},
        "type": "object"
      },
      "RtCollabFlushParams": {
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "description": "Target file — dashed UUID.",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "file_id"
        ],
        "type": "object"
      },
      "RtCollabFlushRequestBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "jsonrpc": {
            "const": "2.0",
            "type": "string"
          },
          "method": {
            "const": "rt.collab_flush",
            "type": "string"
          },
          "params": {
            "$ref": "#/components/schemas/RtCollabFlushParams"
          }
        },
        "required": [
          "jsonrpc",
          "id",
          "method"
        ],
        "type": "object"
      },
      "RtCollabFlushResponseBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "jsonrpc": {
            "const": "2.0",
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/RtCollabFlushResult"
          }
        },
        "required": [
          "jsonrpc",
          "id",
          "result"
        ],
        "type": "object"
      },
      "RtCollabFlushResult": {
        "additionalProperties": false,
        "properties": {
          "flushed": {
            "description": "`true` when a blob write happened; `false` when the CRDT text was unchanged since the last flush (short-circuit).",
            "type": "boolean"
          }
        },
        "required": [
          "flushed"
        ],
        "type": "object"
      },
      "RtErrorCode": {
        "description": "Stable integer error code. Values are frozen across releases — a new denial cause gets a new value, never repurposes an existing one. Application-defined codes (-32099..=-32000):\n· -32001 NO_READ — resource-scoped topic, caller lacks Read (or resource doesn't exist — indistinguishable by design)\n· -32002 NO_SHARE — resource requires Share, caller has Read but not Share\n· -32003 NO_COMMENT — resource requires Comment\n· -32004 TOPIC_FORBIDDEN — identity-scoped mismatch or unknown/malformed topic\n· -32005 SUB_LIMIT — per-connection subscription cap hit\n· -32006 RATE_LIMITED — subscribe-frame token bucket exhausted\n· -32007 NO_EDIT — CRDT edit frame from a caller without Edit\nStandard JSON-RPC 2.0 codes:\n· -32603 INTERNAL_ERROR · -32600 INVALID_REQUEST · -32601 METHOD_NOT_FOUND · -32602 INVALID_PARAMS",
        "type": "integer"
      },
      "RtErrorMessage": {
        "description": "Stable wire vocabulary; matches the corresponding `code`.",
        "enum": [
          "no_read",
          "no_share",
          "no_comment",
          "topic_forbidden",
          "sub_limit",
          "rate_limited",
          "no_edit",
          "internal_error",
          "invalid_request",
          "method_not_found",
          "invalid_params"

            ],
            "type": "string"
          }
        },
        "required": [
          "topic"
        ],
        "type": "object"
      },
      "RtSubscribeRequestBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": [
              "integer",
              "string",
              "null"
            ]
